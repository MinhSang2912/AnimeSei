{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UsePostgres": "true",
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres"
  },
  "Supabase": {
    "Url": "https://your-supabase-url.supabase.co",
    "Key": "YOUR_SUPABASE_ANON_KEY",
    "Bucket": "avatars"
  },
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS!",
    "Issuer": "AnimeSei",
    "Audience": "AnimeSeiClient",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "AniList": {
    "GraphQLUrl": "https://graphql.anilist.co"
  }
}
